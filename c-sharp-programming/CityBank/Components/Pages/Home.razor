@page "/"
@using CityBank.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<CityBankDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>CityBank - Dashboard</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Executive Dashboard</h2>
            <p class="text-muted mb-0">Real-time overview of CityBank financial metrics</p>
        </div>
        <a href="accounts" class="btn btn-primary fw-semibold">
            Manage Accounts →
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading financial metrics...</p>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-primary text-white rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small text-uppercase fw-bold">Total Liquidity</span>
                            <h3 class="fw-bold my-1">@totalBalance.ToString("C")</h3>
                        </div>
                        <span class="fs-1">💰</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Accounts</span>
                            <h3 class="fw-bold my-1 text-dark">@totalAccounts</h3>
                        </div>
                        <span class="fs-1">🏛️</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Active Accounts</span>
                            <h3 class="fw-bold my-1 text-success">@activeAccounts</h3>
                        </div>
                        <span class="fs-1">✅</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Accounts Data Table (READ Operation) -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Recent Accounts</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Account Number</th>
                            <th>Account Holder</th>
                            <th>Type</th>
                            <th>Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var acc in recentAccounts)
                        {
                            <tr>
                                <td class="ps-3"><code>@acc.AccountNumber</code></td>
                                <td class="fw-medium">@acc.AccountHolder</td>
                                <td><span class="badge bg-secondary">@acc.AccountType</span></td>
                                <td class="fw-bold">@acc.Balance.ToString("C")</td>
                                <td>
                                    <span class="badge @(acc.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(acc.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private decimal totalBalance;
    private int totalAccounts;
    private int activeAccounts;
    private List<Account> recentAccounts = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        totalAccounts = await context.Accounts.CountAsync();
        activeAccounts = await context.Accounts.CountAsync(a => a.IsActive);
        totalBalance = await context.Accounts.SumAsync(a => a.Balance);

        recentAccounts = await context.Accounts
            .AsNoTracking()
            .OrderByDescending(a => a.CreatedAt)
            .Take(5)
            .ToListAsync();

        isLoading = false;
    }
}