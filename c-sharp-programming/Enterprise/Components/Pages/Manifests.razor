@page "/manifests"
@using Enterprise.Data.Models
@using Enterprise.Services
@using Enterprise.Components.Controls
@inject IManifestService ManifestService
@inject IContainerService ContainerService

<PageTitle>Shipment Manifests - Enterprise</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">📜 Shipment Manifests</h2>
            <p class="text-muted m-0">Manage global carrier routes and container assignments</p>
        </div>
        <button class="btn btn-primary btn-lg" @onclick="OpenCreateModal">
            + New Manifest
        </button>
    </div>

    @if (manifests == null)
    {
        <p><em>Loading manifests...</em></p>
    }
    else if (!manifests.Any())
    {
        <div class="card p-4 text-center text-muted shadow-sm">
            No shipment manifests registered yet. Click <strong>+ New Manifest</strong> to set up a route.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var m in manifests)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <span class="fw-bold font-monospace">@m.ManifestNumber</span>
                            <div>
                                <span class="badge bg-primary me-2">@m.Carrier</span>
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => DeleteManifest(m.ManifestId)">✕</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <small class="text-muted d-block">Route</small>
                                <strong>@m.OriginHub</strong> ➔ <strong>@m.DestinationHub</strong>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Departure Date</small>
                                    <span>@m.DepartureTime.ToShortDateString()</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Est. Arrival</small>
                                    <span>@m.EstimatedArrival.ToShortDateString()</span>
                                </div>
                            </div>

                            <h6>Assigned Containers (@m.ContainerIds.Count)</h6>
                            <div class="d-flex flex-wrap gap-1">
                                @if (m.ContainerIds.Any())
                                {
                                    @foreach (var cId in m.ContainerIds)
                                    {
                                        <span class="badge bg-secondary font-monospace">@cId</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No containers attached</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<ManifestFormModal IsOpen="isModalOpen" Model="activeModel" AvailableContainers="containers" OnSave="SaveManifest" OnCancel="CloseModal" />

@code {
    private List<ShipmentManifest>? manifests;
    private List<Container> containers = new();

    private bool isModalOpen = false;
    private ShipmentManifest activeModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        manifests = await ManifestService.GetManifestsAsync();
        containers = await ContainerService.GetContainersAsync();
    }

    private void OpenCreateModal()
    {
        activeModel = new ShipmentManifest
        {
            DepartureTime = DateTime.UtcNow,
            EstimatedArrival = DateTime.UtcNow.AddDays(10)
        };
        isModalOpen = true;
    }

    private async Task SaveManifest(ShipmentManifest manifest)
    {
        await ManifestService.CreateManifestAsync(manifest);
        isModalOpen = false;
        await LoadData();
    }

    private async Task DeleteManifest(string id)
    {
        await ManifestService.DeleteManifestAsync(id);
        await LoadData();
    }

    private void CloseModal() => isModalOpen = false;
}