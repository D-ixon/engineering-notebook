@page "/"
@using Enterprise.Data.Models
@using Enterprise.Data.Enums
@using Enterprise.Services
@inject IContainerService ContainerService

<PageTitle>Fleet Dashboard - Enterprise</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-4">
        <h2 class="fw-bold m-0">📊 Logistics Fleet Overview</h2>
        <p class="text-muted m-0">Real-time status summaries and container fleet distribution</p>
    </div>

    @if (containers == null)
    {
        <p><em>Loading metric cards...</em></p>
    }
    else
    {
        <!-- Metric Cards Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-dark text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted">Total Fleet</h6>
                        <h2 class="display-6 fw-bold m-0">@containers.Count</h2>
                        <small class="text-light">Registered Containers</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-uppercase text-light">In Transit</h6>
                        <h2 class="display-6 fw-bold m-0">@containers.Count(c => c.Status == ContainerStatus.InTransit)</h2>
                        <small class="text-light">Active Shipments</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-uppercase text-light">Available</h6>
                        <h2 class="display-6 fw-bold m-0">@containers.Count(c => c.Status == ContainerStatus.Available)</h2>
                        <small class="text-light">Ready at Terminals</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-warning text-dark shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted">Port Hold / Inspection</h6>
                        <h2 class="display-6 fw-bold m-0">@containers.Count(c => c.Status == ContainerStatus.PortHold)</h2>
                        <small class="text-dark">Customs Delayed</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Fleet Summary Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold">Recent Fleet Additions</h5>
                <a href="containers" class="btn btn-sm btn-outline-primary">Manage Containers →</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Target Temp</th>
                            <th>Max Payload</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in containers.Take(5))
                        {
                            <tr>
                                <td class="fw-bold font-monospace">@c.ContainerNumber</td>
                                <td><span class="badge bg-secondary">@c.Type</span></td>
                                <td><span class="badge @GetStatusBadgeClass(c.Status)">@c.Status</span></td>
                                <td>@c.TargetTempCelsius °C</td>
                                <td>@c.MaxPayloadKg.ToString("N0") kg</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Container>? containers;

    protected override async Task OnInitializedAsync()
    {
        containers = await ContainerService.GetContainersAsync();
    }

    private string GetStatusBadgeClass(ContainerStatus status) => status switch
    {
        ContainerStatus.Available => "bg-success",
        ContainerStatus.InTransit => "bg-primary",
        ContainerStatus.PortHold => "bg-warning text-dark",
        ContainerStatus.Maintenance => "bg-danger",
        ContainerStatus.Decommissioned => "bg-dark",
        _ => "bg-secondary"
    };
}